# Supabase (required for auth)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY


# Public app URL used by Mercado Pago webhook notifications
NEXT_PUBLIC_APP_URL=https://YOUR_VERCEL_DOMAIN.vercel.app

# Mercado Pago Pix payments
MERCADO_PAGO_ACCESS_TOKEN=YOUR_MERCADO_PAGO_ACCESS_TOKEN

# Registration access group
REGISTRATION_GROUP_URL=https://chat.whatsapp.com/YOUR_GROUP_INVITE_CODE

# YCloud WhatsApp automation for registration confirmations
YCLOUD_API_KEY=YOUR_YCLOUD_API_KEY
YCLOUD_WHATSAPP_FROM=+15551234567
YCLOUD_DEFAULT_COUNTRY_CODE=55
# Optional: use an approved WhatsApp template instead of direct utility text
# YCLOUD_TEMPLATE_NAME=registration_payment_confirmed
# YCLOUD_TEMPLATE_LANGUAGE=pt_BR

# OpenAI (required for AI endpoints)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Optional: custom ytdl service URL
# YTDL_SERVICE_URL=http://localhost:8080

# Cifra Club API (optional, for chord lookup)
CIFRACLUB_API_URL=http://localhost:3001
# CIFRACLUB_API_TOKEN=

# Worship suggestion enrichment
YOUTUBE_API_KEY=YOUR_YOUTUBE_DATA_API_KEY
LRCLIB_BASE_URL=https://lrclib.net
SOUNDCHARTS_BASE_URL=https://customer.api.soundcharts.com
SOUNDCHARTS_CLIENT_ID=YOUR_SOUNDCHARTS_CLIENT_ID
SOUNDCHARTS_CLIENT_SECRET=YOUR_SOUNDCHARTS_CLIENT_SECRET
SOUNDCHARTS_ACCESS_TOKEN=YOUR_SOUNDCHARTS_ACCESS_TOKEN
SOUNDCHARTS_APP_ID=YOUR_LEGACY_SOUNDCHARTS_APP_ID
SOUNDCHARTS_API_KEY=YOUR_LEGACY_SOUNDCHARTS_API_KEY
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini
YCLOUD_WEBHOOK_SECRET=

# Automation security (generate with: openssl rand -base64 32)
# Keep this key in the deployment secret manager, never in the database.
AUTOMATION_CREDENTIAL_KEY_V1=
AUTOMATION_CREDENTIAL_KEY_VERSION=1
# At least 32 random characters, used to sign short-lived OAuth state.
AUTOMATION_OAUTH_STATE_SECRET=
